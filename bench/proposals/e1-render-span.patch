--- a/core/src/ppu.c	2026-11-25 10:20:38.829729600 +0100
+++ b/core/src/ppu.c	2026-11-25 10:21:51.733440200 +0100
@@ -296,12 +296,115 @@
     fbuf[P.back][line * GB_FB_WIDTH + x] = lut[rgb];
